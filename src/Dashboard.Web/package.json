{
  "name": "dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "undici": "6.28.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
